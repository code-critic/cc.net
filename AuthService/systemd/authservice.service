[Unit]
Description=Code Critic AuthService
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/code-critic/AuthService
EnvironmentFile=/etc/code-critic/authservice.env
ExecStart=/opt/code-critic/AuthService/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8181 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
