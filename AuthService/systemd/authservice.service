[Unit]
Description=Code Critic AuthService
After=network.target

[Service]
Type=simple
User=code-critic
Group=code-critic
WorkingDirectory=/home/code-critic/projects/publish/AuthService
EnvironmentFile=/etc/code-critic/authservice.env
ExecStart=/home/code-critic/projects/publish/AuthService/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8181 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
