<?xml version="1.0" encoding="UTF-8"?>
<SPConfig xmlns="urn:mace:shibboleth:3.0:native:sp:config"
    xmlns:conf="urn:mace:shibboleth:3.0:native:sp:config"
    clockSkew="180">

    <ApplicationDefaults
        entityID="http://code-critic.nti.tul.cz:8080/shibboleth"
        REMOTE_USER="eppn persistent-id targeted-id">

        <Sessions lifetime="28800"
            timeout="3600"
            relayState="ss:mem"
            checkAddress="false"
            handlerSSL="false"
            cookieProps="http">

            <!--
            Phase 1 keeps the recovery path simple and mirrors the old flowdb setup:
            use the TUL IdP directly instead of the federation discovery service.
            This avoids the temporary :8080 discovery return-url metadata mismatch.
            -->
            <SSO entityID="https://shibbo.tul.cz/idp/shibboleth">
                SAML2
            </SSO>

            <Logout>SAML2 Local</Logout>

            <Handler type="MetadataGenerator" Location="/Metadata" signing="false" template="metadata-template.xml"/>
            <Handler type="Status" Location="/Status" acl="127.0.0.1 ::1"/>
            <Handler type="Session" Location="/Session" showAttributeValues="false"/>
            <Handler type="DiscoveryFeed" Location="/DiscoFeed"/>
        </Sessions>

        <Errors supportContact="pavel.exner@tul.cz"
            helpLocation="/about.html"
            styleSheet="/shibboleth-sp/main.css"/>

        <!--
        Phase 1 uses the same simpler TUL metadata source as the historical flowdb setup.
        This avoids an extra dependency on the missing eduID metadata signing cert file.
        -->
        <MetadataProvider
            type="XML"
            validate="true"
            url="https://shibbo.tul.cz/metadata/tul-metadata.xml"
            backingFilePath="tul-metadata.xml"
            reloadInterval="72000"/>

        <AttributeExtractor type="XML" validate="true" reloadChanges="false" path="attribute-map.xml"/>
        <AttributeResolver type="Query" subjectMatch="true"/>
        <AttributeFilter type="XML" validate="true" path="attribute-policy.xml"/>

        <CredentialResolver type="File"
            key="/etc/shibboleth/sp-key.pem"
            certificate="/etc/shibboleth/sp-cert.pem"/>

    </ApplicationDefaults>

    <SecurityPolicyProvider type="XML" validate="true" path="security-policy.xml"/>
    <ProtocolProvider type="XML" validate="true" reloadChanges="false" path="protocols.xml"/>
</SPConfig>
